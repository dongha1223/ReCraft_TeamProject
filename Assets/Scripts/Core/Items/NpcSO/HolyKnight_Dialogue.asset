  m_Script: {fileID: 11500000, guid: d0ad4f278939a0d4ba275ee3522b3848, type: 3}
  m_Name: HolyKnight_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::_2D_Roguelike.DialogueData
  _npcName: "\uC2E0\uC131\uAE30\uC0AC \uB8E8\uC2DC\uC6B0\uC2A4"
  _lines:
  - "\"\uC654\uAD70\uC694. \uCE74\uC5D8.\""
  - "\"\uC804 \uB2F9\uC2E0\uC5D0 \uB300\uD574 \uC54C\uACE0 \uC788\uC8E0. \uADF8\uB9AC\uACE0
    \uADF8\uB0A0 \uC77C\uB3C4.\""
  - "\"...\uC800\uB294 \uC2EC\uD310\uD558\uB7EC \uC628 \uAC8C \uC544\uB2C8\uC5D0\uC694.
    \uB4E4\uC744 \uC900\uBE44\uAC00 \uB418\uC5B4 \uC788\uC5B4\uC694.\""
  _hasChoice: 1
  _repeatDialogue: 0
  _yesResponse: ...
  _noResponse: ...
  _yesLines:
  - "\"\u2026\uC549\uC73C\uC2DC\uC8E0.\""
  - "\uCE74\uC5D8 : \"...\uADF8\uB0A0 \uBC24, \uB098\uB294 \uBD80\uAD00\uC744 \uC783\uC5C8\uACE0
    \uC774\uC131\uC744 \uC783\uC5C8\uC5B4. \uD56D\uBCF5\uD55C \uC790\uB97C \uBCA0\uACE0,
    \uB9C8\uC744\uC744 \uBD88\uD0DC\uC6E0\uC5B4.\""
  - "\uCE74\uC5D8 : \"\uBA48\uCD94\uC9C0....\uC54A\uC558\uC5B4.\""
  - "\"\u2026\uACC4\uC18D \uD558\uC138\uC694.\""
  - "\uCE74\uC5D8 : \"\uADF8 \uC545\uB9C8\uB97C \uC7A1\uC73C\uB7EC \uC628 \uAC74
    \uC18D\uC8C4\uAC00 \uC544\uB2C8\uC57C...\""
  - "\uCE74\uC5D8 : \"\uBA48\uCD94\uB294 \uC21C\uAC04\u2026 \uADF8\uAC83\uB4E4\uC774
    \uBCF4\uC774\uB2C8\uAE4C.\""
  - "\uCE74\uC5D8 : \"\uADF8\uB798\uC11C...\uACC4\uC18D \uAC77\uB294 \uAC70\uC57C...\""
  - "\"\u2026\uC54C\uACA0\uC5B4\uC694. \uADF8\uAC83\uC73C\uB85C \uCDA9\uBD84\uD574\uC694.\""
  _noLines:
  - "\"\u2026\uADF8\uB807\uAC8C \uBBFF\uACE0 \uC788\uAD70\uC694.\""
  - "\uCE74\uC5D8 : \"\uC544\uB2C8, \uC0AC\uC2E4\uC774\uC57C....\uBBFF\uACE0 \uC788\uB294
    \uAC8C \uC544\uB2C8\uB77C\uACE0!\""
  - "\"\uADF8\uAC8C \uC9C4\uC2E4\uC774\uB77C \uC0DD\uAC01 \uD558\uB294 \uAC74\uAC00\uC694?\""
  - "\"\uBCA0\uB978\uACFC \uADF8\uC758 \uB538\uB4E4\uB3C4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD560\uAE4C\uC694?\""
  - "\"\u2026.\uACE0\uD574\uB294\u2026 \uC8FD\uC740 \uC790\uB97C \uC704\uD55C \uAC8C
    \uC544\uB2C8\uC5D0\uC694\u2026 \uB0A8\uC740 \uC790\uB97C\u2026 \uC704\uD55C \uAC70\uC8E0\u2026\""
  _yesRetalkLines:
  - "\"\uB2E4\uC2DC \uC624\uC168\uAD70\uC694.\""
  - "\"..\uACE0\uD574\uC131\uC0AC\uB294 \uD55C \uBC88\uC73C\uB85C \uB05D\uB098\uC9C0
    \uC54A\uC8E0.\""
  - "\"\uC5EC\uC720 \uC788\uB2E4\uBA74, \uC5B8\uC81C\uB4E0\uC9C0 \uC640\uC694. \uB4E4\uC5B4\uB4DC\uB9B4
    \uD14C\uB2C8.\""
  _noRetalkLines:
  - "(\uC4F0\uB7EC\uC9C4 \uCC44)"
  - "\"\u2026\uC544\uC9C1\uB3C4, \uC778\uC815\uD558\uC9C0 \uC54A\uB294\uAD70\uC694.\""
  _retalkLine: ...
