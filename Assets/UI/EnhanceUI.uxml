<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="EnhanceUI.uss" />
    <ui:VisualElement name="enhance-root">
        <ui:VisualElement name="enhance-panel">
            <ui:Button name="btn-reset" text="초기화" />
            <ui:VisualElement name="enhance-main">
                <ui:VisualElement name="enhance-left">
                    <ui:VisualElement name="upgrade-grid">
                        <!-- 물리 공격력(좌) + 스킬 공격력(우) 분할 행 -->
                        <ui:VisualElement name="row-courage" class="upgrade-row-split">
                            <ui:VisualElement class="upgrade-row row-half">
                                <ui:VisualElement class="category-section">
                                    <ui:VisualElement class="category-icon" name="icon-courage" />
                                    <ui:Label class="category-label" text="물리 공격력" />
                                </ui:VisualElement>
                                <ui:VisualElement class="node-chain">
                                    <ui:VisualElement class="chain-connector" />
                                    <ui:VisualElement name="courage-node-0" class="upgrade-node">
                                        <ui:Label class="node-level" text="0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="chain-connector" />
                                    <ui:VisualElement name="courage-node-1" class="upgrade-node">
                                        <ui:Label class="node-level" text="0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="chain-connector" />
                                    <ui:VisualElement name="courage-node-2" class="upgrade-node">
                                        <ui:Label class="node-level" text="0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="chain-connector" />
                                    <ui:VisualElement name="courage-node-3" class="upgrade-node">
                                        <ui:Label class="node-level" text="0" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="col-divider" />
                            <ui:VisualElement class="upgrade-row row-half">
                                <ui:VisualElement class="category-section">
                                    <ui:VisualElement class="category-icon" name="icon-skill" />
                                    <ui:Label class="category-label" text="스킬 공격력" />
                                </ui:VisualElement>
                                <ui:VisualElement class="node-chain">
                                    <ui:VisualElement class="chain-connector" />
                                    <ui:VisualElement name="skill-node-0" class="upgrade-node">
                                        <ui:Label class="node-level" text="0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="chain-connector" />
                                    <ui:VisualElement name="skill-node-1" class="upgrade-node">
                                        <ui:Label class="node-level" text="0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="chain-connector" />
                                    <ui:VisualElement name="skill-node-2" class="upgrade-node">
                                        <ui:Label class="node-level" text="0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="chain-connector" />
                                    <ui:VisualElement name="skill-node-3" class="upgrade-node">
                                        <ui:Label class="node-level" text="0" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="row-divider" />
                        <!-- 체력 행 (구 강인함) -->
                        <ui:VisualElement name="row-endurance" class="upgrade-row">
                            <ui:VisualElement class="category-section">
                                <ui:VisualElement class="category-icon" name="icon-health" />
                                <ui:Label class="category-label" text="체력" />
                            </ui:VisualElement>
                            <ui:VisualElement class="node-chain">
                                <ui:VisualElement class="chain-connector" />
                                <ui:VisualElement name="endurance-node-0" class="upgrade-node">
                                    <ui:Label class="node-level" text="0" />
                                </ui:VisualElement>
                                <ui:VisualElement class="chain-connector" />
                                <ui:VisualElement name="endurance-node-1" class="upgrade-node">
                                    <ui:Label class="node-level" text="0" />
                                </ui:VisualElement>
                                <ui:VisualElement class="chain-connector" />
                                <ui:VisualElement name="endurance-node-2" class="upgrade-node">
                                    <ui:Label class="node-level" text="0" />
                                </ui:VisualElement>
                                <ui:VisualElement class="chain-connector" />
                                <ui:VisualElement name="endurance-node-3" class="upgrade-node">
                                    <ui:Label class="node-level" text="0" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="row-divider" />
                        <!-- 영혼 행 -->
                        <ui:VisualElement name="row-soul" class="upgrade-row">
                            <ui:VisualElement class="category-section">
                                <ui:VisualElement class="category-icon" />
                                <ui:Label class="category-label" text="영혼" />
                            </ui:VisualElement>
                            <ui:VisualElement class="node-chain">
                                <ui:VisualElement class="chain-connector" />
                                <ui:VisualElement name="soul-node-0" class="upgrade-node">
                                    <ui:Label class="node-level" text="0" />
                                </ui:VisualElement>
                                <ui:VisualElement class="chain-connector" />
                                <ui:VisualElement name="soul-node-1" class="upgrade-node">
                                    <ui:Label class="node-level" text="0" />
                                </ui:VisualElement>
                                <ui:VisualElement class="chain-connector" />
                                <ui:VisualElement name="soul-node-2" class="upgrade-node">
                                    <ui:Label class="node-level" text="0" />
                                </ui:VisualElement>
                                <ui:VisualElement class="chain-connector" />
                                <ui:VisualElement name="soul-node-3" class="upgrade-node">
                                    <ui:Label class="node-level" text="0" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- 강화 정보 패널 -->
                    <ui:VisualElement name="upgrade-info">
                        <ui:VisualElement name="info-header">
                            <ui:Label name="info-name-label" text="강화 선택" />
                            <ui:Label name="info-level-label" text="Lv. 0/0" />
                        </ui:VisualElement>
                        <ui:Label name="info-current-desc" text="강화할 항목을 선택하세요." />
                        <ui:VisualElement name="info-next-row">
                            <ui:VisualElement name="info-cost-icon" />
                            <ui:Label name="info-cost-amount" text="0" />
                            <ui:Label name="info-arrow" text="▶" />
                            <ui:Label name="info-next-desc" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- NPC 초상화 -->
                <ui:VisualElement name="portrait-panel">
                    <ui:VisualElement name="portrait-image" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
