/* ── 루트 ─────────────────────────────────────────────────────── */
#enhance-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    pointer-events: none;
}

/* ── 메인 패널 (대화창 175px 위에 위치) ─────────────────────── */
#enhance-panel {
    position: absolute;
    top: 30px; bottom: 175px; left: 40px; right: 140px;
    flex-direction: column;
    overflow: visible;
    opacity: 0;
    pointer-events: none;
    transition-property: opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
}

#enhance-panel.panel-visible {
    opacity: 1;
    pointer-events: auto;
}

/* ── 초기화 버튼 ─────────────────────────────────────────────── */
#btn-reset {
    position: absolute;
    top: -34px;
    right: 0;
    width: 72px;
    height: 28px;
    background-color: rgba(80, 20, 20, 0.92);
    border-color: rgb(160, 60, 60);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(230, 150, 150);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

#btn-reset:hover {
    background-color: rgba(120, 30, 30, 0.95);
    border-color: rgb(210, 80, 80);
    color: rgb(255, 190, 190);
}

#btn-reset:active {
    background-color: rgba(160, 40, 40, 0.95);
}

/* ── 컨텐츠 영역 (그리드 + 초상화) ──────────────────────────── */
#enhance-main {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    min-height: 0;
}

#enhance-left {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

/* ── 업그레이드 그리드 ───────────────────────────────────────── */
#upgrade-grid {
    flex-direction: column;
    justify-content: space-evenly;
    background-color: rgba(12, 10, 32, 0.97);
    border-width: 2px;
    border-color: rgb(120, 95, 40);
    padding: 10px 16px;
    flex-grow: 1;
    min-height: 0;
}

.upgrade-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-height: 0;
}

.category-section {
    width: 88px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.category-icon {
    width: 72px;
    height: 72px;
    background-color: rgba(30, 22, 55, 0.9);
    border-width: 2px;
    border-color: rgb(150, 115, 45);
    border-radius: 4px;
}

.category-label {
    font-size: 14px;
    color: rgb(215, 195, 150);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.node-chain {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.chain-connector {
    flex-grow: 1;
    height: 4px;
    background-color: rgb(100, 78, 35);
    margin: 0 2px;
}

.upgrade-node {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    background-color: rgba(22, 16, 46, 0.95);
    border-width: 2px;
    border-color: rgb(130, 100, 42);
    border-radius: 4px;
}

.upgrade-node:hover {
    border-color: rgb(200, 160, 55);
    background-color: rgba(50, 38, 90, 0.95);
}

.upgrade-node.node-selected {
    border-color: rgb(210, 170, 60);
    background-color: rgba(75, 55, 125, 0.95);
}

.node-level {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 22px;
    height: 22px;
    background-color: rgba(55, 42, 105, 0.95);
    border-width: 1px;
    border-color: rgb(150, 115, 45);
    border-radius: 11px;
    font-size: 11px;
    color: rgb(230, 200, 100);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.row-divider {
    height: 1px;
    background-color: rgb(70, 55, 25);
    margin: 0 8px;
}

/* ── 강화 정보 패널 ─────────────────────────────────────────── */
#upgrade-info {
    height: 130px;
    flex-shrink: 0;
    background-color: rgba(10, 8, 28, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(120, 95, 40);
    padding: 10px 16px;
    flex-direction: column;
    justify-content: space-between;
}

#info-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 55, 25);
    padding-bottom: 6px;
}

#info-name-label {
    font-size: 18px;
    color: rgb(225, 195, 80);
    -unity-font-style: bold;
}

#info-level-label {
    font-size: 16px;
    color: rgb(175, 155, 95);
}

#info-current-desc {
    font-size: 16px;
    color: rgb(215, 195, 150);
    white-space: normal;
    flex-grow: 1;
    padding: 4px 0;
}

#info-next-row {
    flex-direction: row;
    align-items: center;
    height: 26px;
}

#info-cost-icon {
    width: 22px;
    height: 22px;
    background-image: url('../Screenshots/Assets/신념_아이콘.png');
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 4px;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgb(225, 185, 70);
}

#info-cost-amount {
    font-size: 17px;
    color: rgb(225, 185, 70);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-right: 6px;
}

#info-arrow {
    font-size: 14px;
    color: rgb(140, 110, 55);
    margin-right: 8px;
}

#info-next-desc {
    font-size: 15px;
    color: rgb(195, 175, 125);
    flex-grow: 1;
    white-space: normal;
}

/* ── NPC 초상화 ─────────────────────────────────────────────── */
#portrait-panel {
    width: 300px;
    flex-shrink: 0;
    overflow: visible;
}

#portrait-image {
    position: absolute;
    bottom: 15px;
    right: 0;
    width: 320px;
    height: 740px;
    background-image: url('../Screenshots/NPC/샵걸_이미지.png');
    -unity-background-scale-mode: scale-to-fit;
}
